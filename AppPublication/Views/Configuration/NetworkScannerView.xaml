<Window x:Class="AppPublication.Views.Configuration.NetworkScannerView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
        Title="Découverte des écrans sur le réseau" Height="500" Width="650"
        Background="Black" Foreground="White"
        WindowStartupLocation="CenterOwner"
        Closing="Window_Closing">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="Interface réseau de recherche:" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="White" FontWeight="SemiBold"/>
            <telerik:RadComboBox ItemsSource="{Binding Interfaces}" 
                                 SelectedItem="{Binding SelectedInterface, Mode=TwoWay}"
                                 IsEnabled="{Binding IsScanning, Converter={StaticResource BoolNotConverter}}"
                                 Width="400" telerik:StyleManager.Theme="Expression_Dark">
                <telerik:RadComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="2">
                            <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" Margin="0,0,10,0" Foreground="White"/>
                            <TextBlock Text="{Binding IpAddress}" Foreground="DarkGray" FontStyle="Italic"/>
                        </StackPanel>
                    </DataTemplate>
                </telerik:RadComboBox.ItemTemplate>
            </telerik:RadComboBox>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
            <telerik:RadButton Content="Lancer la recherche" Command="{Binding CmdLancerRecherche}" Width="150" Height="30" Margin="0,0,10,0" telerik:StyleManager.Theme="Expression_Dark"/>
            <telerik:RadButton Content="Annuler la recherche" Command="{Binding CmdAnnulerRecherche}" Width="150" Height="30" telerik:StyleManager.Theme="Expression_Dark"/>

            <Control Width="20" Height="20" Margin="20,0,0,0" Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibilityConverter}}" Style="{StaticResource TrailSpinnerStyle}" Foreground="White" />
            <TextBlock Text="Recherche en cours..." VerticalAlignment="Center" Margin="10,0,0,0" Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibilityConverter}}" Foreground="LightGray"/>
        </StackPanel>

        <telerik:RadGridView Grid.Row="2" ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                             AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                             telerik:StyleManager.Theme="Expression_Dark" ShowGroupPanel="False" RowIndicatorVisibility="Collapsed">
            <telerik:RadGridView.Columns>
                <telerik:GridViewSelectColumn />
                <telerik:GridViewDataColumn Header="Adresse IP" DataMemberBinding="{Binding IpAddress}" Width="120" />
                <telerik:GridViewDataColumn Header="Type d'appareil" 
                            DataMemberBinding="{Binding Category, Converter={StaticResource DeviceTypeConverter}}" 
                            Width="180" />
                <telerik:GridViewDataColumn Header="Adresse MAC" DataMemberBinding="{Binding MacAddress}" Width="*" />
            </telerik:RadGridView.Columns>
        </telerik:RadGridView>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <telerik:RadButton Content="Valider" Click="BtnValider_Click" Width="100" Height="30" Margin="0,0,10,0" telerik:StyleManager.Theme="Expression_Dark"/>
            <telerik:RadButton Content="Fermer" Click="BtnFermer_Click" Width="100" Height="30" telerik:StyleManager.Theme="Expression_Dark"/>
        </StackPanel>
    </Grid>
</Window>