<hc:Window x:Class="AppPublication.Views.Configuration.NetworkScannerView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:fj="clr-namespace:FranceJudo.UI.Wpf.Controls;assembly=FranceJudo.UI"
        Title="Découverte des équipements sur le réseau" Height="540" Width="780"
        Background="Black"
        WindowStartupLocation="CenterOwner">

    <b:Interaction.Triggers>
        <b:EventTrigger EventName="Closing">
            <b:InvokeCommandAction Command="{Binding CmdWindowClosing}" />
        </b:EventTrigger>
    </b:Interaction.Triggers>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Style="{StaticResource Header1Style}" Margin="10 10 10 5" Visibility="Visible">
            <TextBlock Text="Scanner réseau local" Style="{StaticResource Header1TextStyle}"/>
        </StackPanel>

        <Border BorderThickness="1" Grid.Row="1" BorderBrush="White" Margin="10,0,10,10">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0" Grid.Column="0" Content="Interface :" Style="{StaticResource LabelStyle}" VerticalAlignment="Center" Margin="0,0,10,0"/>

                    <ComboBox Grid.Row="0" Grid.Column="1" 
                                         ItemsSource="{Binding Interfaces}" 
                                         SelectedItem="{Binding SelectedInterface, Mode=TwoWay}"
                                         IsEnabled="{Binding IsScanning, Converter={StaticResource BoolNotConverter}}"
                                         Width="480">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="2">
                                    <TextBlock Text="{Binding Interface.Description}" Foreground="White" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding IpAddress, StringFormat='({0})'}" Foreground="DarkGray" FontStyle="Italic"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="2,5,0,0">
                        <TextBlock Text="Informations réseau : " Foreground="SlateGray" FontSize="11" />
                        <TextBlock Text="{Binding SelectedInterface.NetworkInfo}" Foreground="LightGray" FontSize="11" FontStyle="Italic"/>
                    </StackPanel>
                </Grid>
                <Line Grid.Row="0" StrokeThickness="1" Stroke="White" Margin="0,35,0,0" X1="0" X2="700" Y1="0" Y2="0" Stretch="Fill" VerticalAlignment="Bottom"/>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,15,0,15">

                    <Button IsDefault="True" Margin="0 0 15 0" Command="{Binding CmdLancerRecherche}" Height="35" Width="120">
                        <WrapPanel Orientation="Horizontal">
                            <Image Source="pack://application:,,,/FranceJudo.UI;component/Wpf/Resources/Media/Icons/black/wizard-32.png" Height="25" Margin="5 0"/>
                            <TextBlock Text="Rechercher" Style="{StaticResource ButtonLabelStyle}" />
                        </WrapPanel>
                    </Button>

                    <Button Margin="0 0 15 0" Command="{Binding CmdAnnulerRecherche}" Height="35" Width="100">
                        <WrapPanel Orientation="Horizontal">
                            <Image Source="pack://application:,,,/FranceJudo.UI;component/Wpf/Resources/Media/Icons/black/whole_hand-32.png" Height="25" Margin="5 0"/>
                            <TextBlock Text="Arrêter" Style="{StaticResource ButtonLabelStyle}" />
                        </WrapPanel>
                    </Button>

                    <fj:TrailSpinner Width="18" Height="18" Margin="10,0,0,0" Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibilityConverter}}" Foreground="White" />
                    <Label Content="Recherche et analyse en cours..." VerticalAlignment="Center" Margin="5,0,0,0" Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibilityConverter}}" Style="{StaticResource LabelStyle}" Foreground="LightGray"/>
                </StackPanel>

                <DataGrid Grid.Row="2" 
                      ItemsSource="{Binding Devices}" 
                      SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                      AutoGenerateColumns="False" 
                      IsReadOnly="True" 
                      SelectionMode="Single"
                      Style="{StaticResource GridViewStyle1}"
                      HeadersVisibility="Column"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Adresse IP" Binding="{Binding IpAddress}" Width="110" />
                        <DataGridTextColumn Header="Hostname" Binding="{Binding Hostname}" Width="150" />
                        <DataGridTextColumn Header="Type d'appareil" Binding="{Binding Category, Converter={StaticResource DeviceTypeConverter}}" Width="160" />
                        <DataGridTextColumn Header="Adresse MAC" Binding="{Binding MacAddress}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <WrapPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal" Grid.Row="2" Margin="0 0 0 10">
            <Button x:Name="ButOk" Height="35" MinWidth="90" Margin="0,0,15,0"
                               Command="{Binding CmdValider}"
                               CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Window}}">
                <Grid>
                    <TextBlock Text="Valider" Style="{StaticResource ButtonLabelStyle}" />
                </Grid>
            </Button>

            <Button x:Name="ButCancel" Height="35" MinWidth="90"
                               Command="{Binding CmdFermer}" 
                               CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Window}}">
                <Grid>
                    <TextBlock Text="Fermer" Style="{StaticResource ButtonLabelStyle}" />
                </Grid>
            </Button>
        </WrapPanel>
    </Grid>
</hc:Window>