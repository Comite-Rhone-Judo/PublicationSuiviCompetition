    <Window x:Class="AppPublication.Views.Configuration.ConfigurationPublicationSiteInterneView"
            xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
            xmlns:local="clr-namespace:AppPublication.Views.Configuration"
            mc:Ignorable="d"
            Title="Configuration de la chambre d'appel" Height="540" Width="960" Background="Black">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <!-- CONFIGURATION GENERALE -->
            <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource Header1Style}" Margin="10 10 10 5" Visibility="Visible" >
                <TextBlock Text="Publication" Style="{StaticResource Header1TextStyle}"/>
            </StackPanel>
        <Border BorderThickness="1" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" BorderBrush="White" Margin="10,0,10,10" Width="920" Height="50">
            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0 0 0 0" HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="0 0 0 0">
                    <Label  HorizontalAlignment="Right" Content="Déroulement:" Style="{StaticResource LabelStyle}" Margin="0 0 0 0"/>
                    <Image Source="pack://application:,,,/FranceJudo.UI;component/Wpf/Resources/Media/Icons/black/info-32.png" Height="20" Margin="0 0 0 0"
                       ToolTip="Délai en secondes de déroulement des informations."/>
                    <telerik:RadNumericUpDown  Value="{Binding GestionnaireSiteInterne.DelaiDeroulementSec}" Width="100" Height="20" Minimum="1" Maximum="600" SmallChange="1" CustomUnit="sec." HideTrailingZeros="True" Margin="10 0 0 0"/>
                    <Label HorizontalAlignment="Right" Content="Sec." Style="{StaticResource LabelStyle}" />
                </StackPanel>
                <Line StrokeThickness="1" Stroke="White" Margin="10" X1="0" X2="0" Y1="0" Y2="1" Stretch="Fill"/>
                <StackPanel Orientation="Horizontal" Margin="0 0 10 0">
                    <Label  HorizontalAlignment="Right" Content="Profondeur:" Style="{StaticResource LabelStyle}" Margin="0 0 0 0"/>
                    <Image Source="pack://application:,,,/FranceJudo.UI;component/Wpf/Resources/Media/Icons/black/info-32.png" Height="20" Margin="0 0 0 0"
                       ToolTip="Nombre de combats à prendre en compte dans la chambre d'appel"/>
                    <telerik:RadNumericUpDown  Value="{Binding GestionnaireSiteInterne.NbProchainsCombats}" Width="100" Height="20" Minimum="1" Maximum="99" SmallChange="1" HideTrailingZeros="True" Margin="10 0 0 0"/>
                </StackPanel>
                <Line StrokeThickness="1" Stroke="White" Margin="10" X1="0" X2="0" Y1="0" Y2="1" Stretch="Fill"/>
                <StackPanel Grid.Row="0" Grid.Column="3" Orientation="Horizontal">
                    <Label HorizontalAlignment="Right" Content="Actualisation du site:" Style="{StaticResource LabelStyle}" />
                    <Image Source="pack://application:,,,/FranceJudo.UI;component/Wpf/Resources/Media/Icons/black/info-32.png" Height="20" Margin="0 0 0 0" ToolTip="Délai en secondes entre 2 générations du site interne."/>
                    <telerik:RadNumericUpDown  Value="{Binding GestionnaireSiteInterne.DelaiGenerationSec}" Width="100" Height="20" Minimum="10" Maximum="600" SmallChange="10" CustomUnit="sec." HideTrailingZeros="True" Margin="10 0 0 0"/>
                    <Label HorizontalAlignment="Right" Content="Sec." Style="{StaticResource LabelStyle}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- CONFIGURATION PUBLICATION -->
            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource Header1Style}" Margin="10 0 10 5" Visibility="Visible" >
                <TextBlock Text="Ecrans d'appel" Style="{StaticResource Header1TextStyle}"/>
            </StackPanel>
        <Border BorderThickness="1" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" BorderBrush="White" Margin="10,0,10,10" Width="920" Height="300">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,5">
                    <telerik:RadButton Command="{Binding GestionnaireSiteInterne.ConfigurationEcransViewModel.CmdAjouterEcran}" 
                                       Style="{StaticResource RadButtonStyleToolbar}"
                                       telerik:StyleManager.Theme="Expression_Dark"
                                       ToolTip="Ajouter un nouvel écran"
                                       Width="30" Height="30"
                                       Tag="pack://application:,,,/FranceJudo.UI;component/Wpf/Resources/Media/Icons/black/add_list-32.png">
                        <Button.RenderTransform>
                            <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                        </Button.RenderTransform>
                    </telerik:RadButton>

                </StackPanel>
                <telerik:RadGridView x:Name="EcransAppelGrid" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" ItemsSource="{Binding GestionnaireSiteInterne.ConfigurationEcransViewModel.EcransViewModels}" 
                                     Style="{StaticResource GridViewStyle1}"
                                     ShowGroupPanel="False"
                                     AutoGenerateColumns="False"
                                     IsReadOnly="False"
                                     CanUserInsertRows="False"
                                     CanUserDeleteRows="False"
                                     EnableRowVirtualization="True" 
                                    ActionOnLostFocus="CommitEdit"
                                    EnableColumnVirtualization="False"
                                    GroupRenderMode="Flat"
                                                 Margin="10,10,0,10"
                                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 Width="890">
                    <telerik:RadGridView.Columns>

                        <telerik:GridViewDataColumn Header="N°" DataMemberBinding="{Binding Id}" IsReadOnly="True" Width="25" TextAlignment="Center" ToolTip="ID autogénéré de l'écran" />

                        <telerik:GridViewDataColumn Header="Description" DataMemberBinding="{Binding Description}" Width="90">
                            <telerik:GridViewDataColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Description}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="5"/>
                                </DataTemplate>
                            </telerik:GridViewDataColumn.CellTemplate>
                        </telerik:GridViewDataColumn>

                        <telerik:GridViewDataColumn Header="Réseau" 
                                                                DataMemberBinding="{Binding RawUserInput, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" 
                                                                Width="195" 
                                                                ToolTip="Double-cliquez pour modifier l'IP ou le Hostname">
                            <telerik:GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid Margin="0 0 0 0" HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="5">
                                            <TextBlock Text="{Binding AdresseIP}" Foreground="White" FontWeight="Bold" FontSize="12"/>
                                            <Control Style="{StaticResource TrailSpinnerStyle}" Width="14" Height="14" Foreground="White" Margin="5,0" 
                                                            Visibility="{Binding IsRechercheIpEnCours, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                            <TextBlock Text=" - " Foreground="DimGray" VerticalAlignment="Center" Margin="2,0"/>

                                            <TextBlock Text="{Binding Hostname}" Foreground="DarkGray" FontSize="11" VerticalAlignment="Center"/>
                                            <Control Style="{StaticResource TrailSpinnerStyle}" Width="14" Height="14" Foreground="White" Margin="5,0" 
                                                            Visibility="{Binding IsRechercheHostnameEnCours, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                        </StackPanel>
                                        <telerik:RadButton Grid.Column="1" Command="{Binding CmdOuvrirScanner}" 
                    ToolTip="Rechercher sur le réseau"
                    Width="20" Height="20" Margin="10,0,0,0"
                    telerik:StyleManager.Theme="Expression_Dark"
                    Style="{StaticResource RadButtonStyleToolbar}"
                    Tag="pack://application:,,,/FranceJudo.UI;component/Wpf/Resources/Media/Icons/black/search-32.png" />
                                    </Grid>
                                </DataTemplate>
                            </telerik:GridViewColumn.CellTemplate>
                        </telerik:GridViewDataColumn>

                        <telerik:GridViewDataColumn Header="# Combats" Width="72">
                            <telerik:GridViewDataColumn.HeaderCellStyle>
                                <Style TargetType="telerik:GridViewHeaderCell" BasedOn="{StaticResource {x:Type telerik:GridViewHeaderCell}}">
                                    <Setter Property="ToolTip" Value="Indique le nombre de combats à afficher sur un tapis. Attention, si trop de combats sont spécifiés, la liste peut être tronquée par manque de place sur l'écran" />
                                </Style>
                            </telerik:GridViewDataColumn.HeaderCellStyle>
                            <telerik:GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding NbCombatsPage}" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="5"/>
                                </DataTemplate>
                            </telerik:GridViewColumn.CellTemplate>
                            <telerik:GridViewColumn.CellEditTemplate>
                                <DataTemplate>
                                    <telerik:RadComboBox ItemsSource="{Binding NbCombatsPageOptions}" 
                                                                 SelectedItem="{Binding NbCombatsPage, Mode=TwoWay}"
                                                                 telerik:StyleManager.Theme="Expression_Dark"
                                                                 VerticalAlignment="Center"
                                                                 HorizontalAlignment="Stretch"
                                                                 Margin="2"/>
                                </DataTemplate>
                            </telerik:GridViewColumn.CellEditTemplate>

                        </telerik:GridViewDataColumn>
                        <telerik:GridViewDataColumn Header="Disposition" IsResizable="False" Width="85">
                            <telerik:GridViewDataColumn.HeaderCellStyle>
                                <Style TargetType="telerik:GridViewHeaderCell" BasedOn="{StaticResource {x:Type telerik:GridViewHeaderCell}}">
                                    <Setter Property="ToolTip" Value="Nombre de tapis à grouper sur un seul écran (1, 2, 4, 6 ou 8). Attention, si on groupe trop de tapis sur un écran trop petit, les textes peuvent être tronqués"/>
                                </Style>
                            </telerik:GridViewDataColumn.HeaderCellStyle>

                            <telerik:GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" Margin="5">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource GroupementConverter}">
                                                <Binding Path="Groupement" />
                                                <Binding Path="Disposition" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </DataTemplate>
                            </telerik:GridViewColumn.CellTemplate>
                            <telerik:GridViewColumn.CellEditTemplate>
                                <DataTemplate>
                                    <telerik:RadComboBox ItemsSource="{Binding GroupementOptions}" 
                                                         SelectedItem="{Binding Groupement, Mode=TwoWay}"
                                                         telerik:StyleManager.Theme="Expression_Dark"
                                                         VerticalAlignment="Center"
                                                         HorizontalAlignment="Stretch"
                                                         Margin="2">
                                        <telerik:RadComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock>
                                                    <TextBlock.Text>
                                                        <MultiBinding Converter="{StaticResource GroupementConverter}">
                                                            <Binding />
                                                            <Binding Path="DataContext.Disposition" RelativeSource="{RelativeSource AncestorType=telerik:RadComboBox}" />
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </DataTemplate>
                                        </telerik:RadComboBox.ItemTemplate>
                                    </telerik:RadComboBox>
                                </DataTemplate>
                            </telerik:GridViewColumn.CellEditTemplate>
                        </telerik:GridViewDataColumn>

                        <telerik:GridViewDataColumn Header="Tapis en" IsResizable="False" Width="65">
                            <telerik:GridViewDataColumn.HeaderCellStyle>
                                <Style TargetType="telerik:GridViewHeaderCell" BasedOn="{StaticResource {x:Type telerik:GridViewHeaderCell}}">
                                    <Setter Property="ToolTip" Value="Disposition des tapis à l'affichage sur l'écran (Ligne ou Colonne)"/>
                                </Style>
                            </telerik:GridViewDataColumn.HeaderCellStyle>
                            <telerik:GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Disposition}" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="5"/>
                                </DataTemplate>
                            </telerik:GridViewColumn.CellTemplate>

                            <telerik:GridViewColumn.CellEditTemplate>
                                <DataTemplate>
                                    <telerik:RadComboBox ItemsSource="{Binding DispositionOptions}" 
                                     SelectedItem="{Binding Disposition, Mode=TwoWay}"
                                     telerik:StyleManager.Theme="Expression_Dark"
                                     VerticalAlignment="Center"
                                     HorizontalAlignment="Stretch"
                                     Margin="2"/>
                                </DataTemplate>
                            </telerik:GridViewColumn.CellEditTemplate>

                        </telerik:GridViewDataColumn>

                        <telerik:GridViewDataColumn Header="Combats en"
                                                            IsResizable="False"
                                                            Width="80"
                                                            IsReadOnlyBinding="{Binding AjusteTailleTexte}">
                            <telerik:GridViewDataColumn.HeaderCellStyle>
                                <Style TargetType="telerik:GridViewHeaderCell" BasedOn="{StaticResource {x:Type telerik:GridViewHeaderCell}}">
                                    <Setter Property="ToolTip" Value="Disposition de l'affichage des combats, soit en ligne (écartement/Nom sur la même ligne) ou colonne (écartement/Nom empilés"/>
                                </Style>
                            </telerik:GridViewDataColumn.HeaderCellStyle>
                            <telerik:GridViewDataColumn.CellStyle>
                                <Style TargetType="telerik:GridViewCell" BasedOn="{StaticResource {x:Type telerik:GridViewCell}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AjusteTailleTexte}" Value="True">
                                            <Setter Property="Foreground" Value="LightSlateGray" />
                                            <Setter Property="Opacity" Value="1.0" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </telerik:GridViewDataColumn.CellStyle>

                            <telerik:GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock x:Name="TxtDispositionCombat" Text="{Binding DispositionCombat}" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="5"/>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding AjusteTailleTexte}" Value="True">
                                            <Setter TargetName="TxtDispositionCombat" Property="Foreground" Value="DimGray" />
                                            <Setter TargetName="TxtDispositionCombat" Property="Opacity" Value="0.6" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </telerik:GridViewColumn.CellTemplate>

                            <telerik:GridViewColumn.CellEditTemplate>
                                <DataTemplate>
                                    <telerik:RadComboBox x:Name="ComboDispositionCombat" ItemsSource="{Binding DispositionOptions}" 
                                     SelectedItem="{Binding DispositionCombat, Mode=TwoWay}"
                                     telerik:StyleManager.Theme="Expression_Dark"
                                     VerticalAlignment="Center"
                                     HorizontalAlignment="Stretch"
                                     Margin="2"/>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding AjusteTailleTexte}" Value="True">
                                            <Setter TargetName="ComboDispositionCombat" Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </telerik:GridViewColumn.CellEditTemplate>

                        </telerik:GridViewDataColumn>

                        <telerik:GridViewDataColumn Header="Ajustement" IsResizable="False" Width="75">
                            <telerik:GridViewDataColumn.HeaderCellStyle>
                                <Style TargetType="telerik:GridViewHeaderCell" BasedOn="{StaticResource {x:Type telerik:GridViewHeaderCell}}">
                                    <Setter Property="ToolTip" Value="Calcul la taille des textes et la disposition des combats automatiquement pour maximiser l'affichage en fonction de la place disponibe. Peut ne pas fonctionner sur certains navigateurs, notamment SmartTV"/>
                                </Style>
                            </telerik:GridViewDataColumn.HeaderCellStyle>
                            <telerik:GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" Margin="5">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Aucun" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding AjusteTailleTexte}" Value="True">
                                                        <Setter Property="Text" Value="Auto" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </telerik:GridViewColumn.CellTemplate>

                            <telerik:GridViewColumn.CellEditTemplate>
                                <DataTemplate>
                                    <CheckBox  IsChecked="{Binding AjusteTailleTexte, Mode=TwoWay}"
                                                       Content="Auto"
                                                     telerik:StyleManager.Theme="Expression_Dark"
                                                     VerticalAlignment="Center"
                                                     HorizontalAlignment="Stretch"
                                                     Margin="2"/>
                                </DataTemplate>
                            </telerik:GridViewColumn.CellEditTemplate>
                        </telerik:GridViewDataColumn>

                        <telerik:GridViewColumn Header="Tapis affichés" IsResizable="False" Width="150">
                            <telerik:GridViewColumn.HeaderCellStyle>
                                <Style TargetType="telerik:GridViewHeaderCell" BasedOn="{StaticResource {x:Type telerik:GridViewHeaderCell}}">
                                    <Setter Property="ToolTip" Value="Liste des tapis à afficher sur l'écran"/>
                                </Style>
                            </telerik:GridViewColumn.HeaderCellStyle>
                            <telerik:GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ListeTapisSelectionnesAffiche, FallbackValue='Aucun tapis'}" VerticalAlignment="Center" Margin="5"/>
                                </DataTemplate>
                            </telerik:GridViewColumn.CellTemplate>

                            <telerik:GridViewColumn.CellEditTemplate>
                                <DataTemplate>
                                    <ItemsControl ItemsSource="{Binding ListeTapisViewModels}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Content="{Binding DisplayName}" 
                                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                          Style="{StaticResource CheckboxStyle}"
                                                          Margin="2,0,8,0"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DataTemplate>
                            </telerik:GridViewColumn.CellEditTemplate>
                        </telerik:GridViewColumn>

                        <telerik:GridViewColumn IsResizable="False" Header="" Width="30">
                            <telerik:GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <telerik:RadButton Command="{Binding DeleteCommand}" 
                                                       CommandParameter="{Binding}"
                                                       ToolTip="Supprimer cet écran"
                                                       Width="20" Height="20"
                                                       telerik:StyleManager.Theme="Expression_Dark"
                                                       Style="{StaticResource RadButtonStyleToolbar}"
                                                       Tag="pack://application:,,,/FranceJudo.UI;component/Wpf/Resources/Media/Icons/black/delete-32.png">
                                    </telerik:RadButton>
                                </DataTemplate>
                            </telerik:GridViewColumn.CellTemplate>
                        </telerik:GridViewColumn>

                    </telerik:RadGridView.Columns>
                </telerik:RadGridView>
            </Grid>
        </Border>

        <!-- BLOC BOUTONS -->
            <WrapPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal" Grid.Row="4" Margin="5" Grid.ColumnSpan="2" >
                <telerik:RadButton x:Name="ButOk" Width="70" Height="30" telerik:StyleManager.Theme="Expression_Dark" Click="ButOk_Click">
                    <WrapPanel Orientation="Horizontal">
                        <Label x:Name="ButOkLabel"  Content="Ok" Foreground="White"/>
                    </WrapPanel>
                </telerik:RadButton>
            </WrapPanel>
        </Grid>
    </Window>
