<hc:Window x:Class="AppPublication.Views.Configuration.ConfigurationGeneraleView"
            xmlns:hc="https://handyorg.github.io/handycontrol"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
            xmlns:local="clr-namespace:AppPublication.Views.Configuration"
            mc:Ignorable="d"
            Title="Configuration Générale" Height="330" Width="920" Background="Black">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="auto"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <!-- CONFIGURATION GENERALE -->
        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource Header1Style}" Margin="10 10 10 5" Visibility="Visible" >
            <TextBlock Text="Général" Style="{StaticResource Header1TextStyle}"/>
        </StackPanel>
        <Border BorderThickness="1" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" BorderBrush="White" Margin="10,0,10,10" Width="880" Height="200">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                <Line Grid.Row="0" Grid.Column="2" HorizontalAlignment="Center" Grid.RowSpan="4" StrokeThickness="1" Stroke="White" Margin="5" Y1="0" Y2="1" Stretch="Fill"/>

                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0 10 0 0">
                    <Label  HorizontalAlignment="Right" Content="Sélection du logo :" Style="{StaticResource LabelStyle}" />
                    <Image Source="pack://application:,,,/FranceJudo.UI;component/Wpf/Resources/Media/Icons/black/info-32.png" Height="20" Margin="0 0 0 0" ToolTip="Logo à afficher dans le bandeau d'entête du site"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal">
                    <ComboBox ItemsSource="{Binding FichiersLogo}" Height="20" Width="130" DisplayMemberPath="Name" Name="LogoList" Margin="10 0 0 0" IsSynchronizedWithCurrentItem="True" SelectedItem="{Binding SelectedLogo}"/>
                    <Button ToolTip="Ajouter un logo: Format: png, taille max.: 200x200. Le fichier doit contenir 'logo' dans son nom" Height="28" Width="28" Padding="0 0 0 0"
                            Focusable="False" Margin="5 0 0 0"
                            Command="{Binding Path=CmdAjouterLogo}">
                        <Grid>
                            <Image Source="pack://application:,,,/FranceJudo.UI;component/Wpf/Resources/Media/Icons/black/add_image-32.png" Height="20" Width="20"/>
                        </Grid>
                    </Button>
                </StackPanel>
                <Border Grid.Column="1" Grid.Row="0" Grid.RowSpan="3" Background="LightGray" Width="120" Margin="0 10 0 0" VerticalAlignment="Center">
                    <Image  Source="{Binding ElementName=LogoList, Path=SelectedItem.FullName}" Width="120" Height="120"/>
                </Border>

                <StackPanel Grid.Row="0" Grid.Column="3" Orientation="Horizontal" Margin="0 10 0 0">
                    <Label HorizontalAlignment="Right" Content="Répertoire d'export :" Style="{StaticResource LabelStyle}" />
                    <Image Source="pack://application:,,,/FranceJudo.UI;component/Wpf/Resources/Media/Icons/black/info-32.png" Height="20" Margin="0 0 0 0" ToolTip="Répertoire racine dans lequel les données du site sont générées et publiées"/>
                </StackPanel>
                <TextBox Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="2" Height="20" Margin="5 -10 5 5" Text = "{Binding Path=RepertoireRacine}" IsEnabled="False"/>
                <Button Grid.Row="2" Grid.Column="3" Width="105" Height="30" Command="{Binding CmdGetRepertoireRacine}" Margin="-70 0 0 0">
                    <Grid>
                        <TextBlock Text="Sélectionner ..." Style="{StaticResource ButtonLabelStyle}"/>
                    </Grid>
                </Button>

                <StackPanel Grid.Row="2" Grid.Column="4" Orientation="Horizontal" Margin="0 -5 0 0">
                    <CheckBox Content="Effacer au démarrage" Style="{StaticResource CheckboxStyle}"
                            IsChecked="{Binding Path=EffacerAuDemarrage}"
                            Margin="0 0 10 0">
                    </CheckBox>
                    <Image Source="pack://application:,,,/FranceJudo.UI;component/Wpf/Resources/Media/Icons/black/info-32.png" Height="20" Margin="0 0 0 0" ToolTip="Si cochée, supprime tout le contenu préalable du répertoire au démarrage. Le site distant sera également effacé."/>
                </StackPanel>

                <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="6" Orientation="Vertical">
                    <StackPanel Orientation="Horizontal">
                        <CheckBox   Content="Utiliser un intitulé de compétition commun" Style="{StaticResource CheckboxStyle}" IsChecked="{Binding Path=UseIntituleCommun}"/>
                        <Image Source="pack://application:,,,/FranceJudo.UI;component/Wpf/Resources/Media/Icons/black/info-32.png" Height="20" Margin="5 0 0 0" ToolTip="Si cochée, en cas de gestion avec plusieurs compétitions simultanément (ex. Districts),  utilise l'intitulé commun configuré au lieu du titre de la 1ère compétition."/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="30 -5 0 0" >
                        <TextBox Height="24" VerticalScrollBarVisibility="Auto" Margin="5 5 5 5" Width="300"
                                 Text = "{Binding Path=IntituleCommun}"
                                 IsEnabled="{Binding Path=UseIntituleCommun}"/>
                    </StackPanel>
                </StackPanel>

            </Grid>
        </Border>

        <!-- BLOC BOUTONS -->
        <WrapPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal" Grid.Row="4" Margin="0,0,0,0" Grid.ColumnSpan="3" Grid.Column="0" >
            <Button x:Name="ButOk" Width="70" Click="ButOk_Click">
                <Grid>
                    <TextBlock x:Name="ButOkLabel" Style="{StaticResource ButtonLabelStyle}"  Text="OK" Foreground="White"/>
                </Grid>
            </Button>
        </WrapPanel>
    </Grid>
</hc:Window>
