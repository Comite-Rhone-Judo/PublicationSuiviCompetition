<hc:Window x:Class="AppPublication.Views.Configuration.ConfigurationPublicationSiteView"
            xmlns:hc="https://handyorg.github.io/handycontrol"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
            xmlns:local="clr-namespace:AppPublication.Views.Configuration"
            mc:Ignorable="d"
            Title="Configuration de la Publication Coachs &amp; Public" Height="400" Width="760" Background="Black">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="269"/>
            <ColumnDefinition Width="102.199"/>
            <ColumnDefinition Width="auto"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <!-- CONFIGURATION PUBLICATION -->
        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource Header1Style}" Margin="10 10 10 5" Visibility="Visible" >
            <TextBlock Text="Publication Coachs &amp; Public" Style="{StaticResource Header1TextStyle}"/>
        </StackPanel>

        <Border BorderThickness="1" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" BorderBrush="White" Margin="10,0,10,16" >
            <Grid Margin="5 5 5 5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="3"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="3"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="3"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                    <Label HorizontalAlignment="Right" Content="Actualisation du site :" Style="{StaticResource LabelStyle}" />
                    <Image Source="pack://application:,,,/FranceJudo.UI;component/Wpf/Resources/Media/Icons/black/info-32.png" Height="20" Margin="0 0 0 0" ToolTip="Délai en secondes entre 2 générations du site pour le grand public."/>
                    <hc:NumericUpDown Value="{Binding GestionnaireSitePublique.DelaiGenerationSec}" 
                                       Width="100" Height="20" 
                                       Minimum="10" Maximum="600" 
                                       Increment="10" 
                                       Margin="10 0 0 0"/>
                    <Label HorizontalAlignment="Right" Content="Sec." Style="{StaticResource LabelStyle}" />
                </StackPanel>
               
                <StackPanel Grid.Row="0" Grid.Column="2"  Orientation="Horizontal" Margin="0 0 0 0">
                    <Label  HorizontalAlignment="Right" Content="Actualisation du client :" Style="{StaticResource LabelStyle}" Margin="0 0 0 0"/>
                    <Image Source="pack://application:,,,/FranceJudo.UI;component/Wpf/Resources/Media/Icons/black/info-32.png" Height="20" Margin="0 0 0 0" ToolTip="Délai en secondes d'actualisation automatique du site côté client si l'utilisateur coche la case 'Actualiser'."/>
                    <hc:NumericUpDown   Value="{Binding GestionnaireSitePublique.DelaiActualisationClientSec}" 
                                       Width="100" Height="20" 
                                       Minimum="10" Maximum="600" 
                                       Increment="10" 
                                       Margin="10 0 0 0"/>
                    <Label HorizontalAlignment="Right" Content="Sec." Style="{StaticResource LabelStyle}" />
                </StackPanel>

                <Line Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" StrokeThickness="1" Stroke="DimGray" Margin="10,0,10,0" X1="0" X2="1" Stretch="Fill"/>
                <Line Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" StrokeThickness="1" Stroke="DimGray" Margin="10 0 10 0" X1="0" X2="1" Stretch="Fill"/>

                <StackPanel Grid.Row="2" Grid.Column="0"  Orientation="Vertical">
                    <StackPanel  Orientation="Horizontal">
                        <CheckBox   Content="Afficher les Poules en colonnes" Style="{StaticResource CheckboxStyle}"
                            IsChecked="{Binding Path=GestionnaireSitePublique.PouleEnColonnes}">
                        </CheckBox>
                        <Image Source="pack://application:,,,/FranceJudo.UI;component/Wpf/Resources/Media/Icons/black/info-32.png" Height="20" Margin="5 0 0 0" ToolTip="Si cochée, les poules seront affichées en colonnes selon les critères de taille. Affichage en diagonale sinon."/>
                    </StackPanel >
                    <StackPanel Orientation="Horizontal" Margin="30 -5 0 0">
                        <CheckBox Style="{StaticResource CheckboxStyle}"
                    IsChecked="{Binding Path=GestionnaireSitePublique.PouleToujoursEnColonnes, Converter={StaticResource BoolNotConverter}}"
                    IsEnabled="{Binding Path=GestionnaireSitePublique.PouleEnColonnes, Mode=OneWay}"
                    Margin="0 0 0 0"
                    Content="taille max. poule en colonne :">
                        </CheckBox>
                        <Image Source="pack://application:,,,/FranceJudo.UI;component/Wpf/Resources/Media/Icons/black/info-32.png" Height="20" Margin="0 0 0 0"
                       ToolTip="Taille minimale de la poule au-dessus de laquelle la disposition est en diagonale."/>
                        <hc:NumericUpDown Grid.Row="2" Grid.Column="3" 
                       Value="{Binding GestionnaireSitePublique.TailleMaxPouleColonnes}" 
                       Width="80" Height="20" 
                       Minimum="2" Maximum="999" 
                       Increment="1" 
                       Margin="5 0 5 0">
                            <hc:NumericUpDown.IsEnabled>
                                <MultiBinding Converter="{StaticResource BoolOperationConverter}" ConverterParameter="not_a_and_b"  Mode="OneWay">
                                    <Binding Path="GestionnaireSitePublique.PouleToujoursEnColonnes" Mode="OneWay"/>
                                    <Binding Path="GestionnaireSitePublique.PouleEnColonnes" Mode="OneWay"/>
                                </MultiBinding>
                            </hc:NumericUpDown.IsEnabled>
                        </hc:NumericUpDown>
                    </StackPanel>
                </StackPanel>

                <Line Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center" Grid.RowSpan="7" StrokeThickness="1" Stroke="White" Margin="5" Y1="0" Y2="1" Stretch="Fill"/>

                <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Vertical">
                    <StackPanel  Orientation="Horizontal">
                        <CheckBox   Content="Activer l'actualisation par défaut" Style="{StaticResource CheckboxStyle}"
                                            IsChecked="{Binding Path=GestionnaireSitePublique.ActualisationClientDefaut}">
                        </CheckBox>
                        <Image Source="pack://application:,,,/FranceJudo.UI;component/Wpf/Resources/Media/Icons/black/info-32.png" Height="20" Margin="5 0 0 0" ToolTip="Si cochée, l'actualisation coté client est activée par défaut."/>
                    </StackPanel >
                </StackPanel>

                <Line Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" StrokeThickness="1" Stroke="DimGray" Margin="10,0,10,0" X1="0" X2="1" Stretch="Fill"/>
                <Line Grid.Row="3" Grid.Column="2" VerticalAlignment="Center" StrokeThickness="1" Stroke="DimGray" Margin="10 0 10 0" X1="0" X2="1" Stretch="Fill"/>

                <StackPanel Grid.Row="4" Grid.Column="0" Orientation="Vertical">
                    <StackPanel Orientation="Horizontal">
                        <CheckBox Content="Publier 'Prochains Combats'" Style="{StaticResource CheckboxStyle}"
                                                            IsChecked="{Binding Path=GestionnaireSitePublique.PublierProchainsCombats}"/>
                        <Image Source="pack://application:,,,/FranceJudo.UI;component/Wpf/Resources/Media/Icons/black/info-32.png" Height="20" Margin="5 0" ToolTip="Si cochée, provoque l'ajout des menus 'Prochains Combats' qui liste les combats à venir par catégories et 'Se Prépare' qui liste les prochains combats sur chaque tapis selon la profondeur de la chambre d'appel."/>
                    </StackPanel>
                    <StackPanel Orientation="Vertical" VerticalAlignment="Top">
                        <StackPanel Orientation="Horizontal" Margin="30 0 0 -5">
                            <Label HorizontalAlignment="Right" Content="Profondeur chambre d'appel :" Style="{StaticResource LabelStyle}" Margin="0 0 0 0"/>
                            <Image Source="pack://application:,,,/FranceJudo.UI;component/Wpf/Resources/Media/Icons/black/info-32.png" Height="20" Margin="0 0 0 0" ToolTip="Nombre de combats à afficher dans la chambre d'appel."/>
                            <hc:NumericUpDown IsEnabled="{Binding Path=GestionnaireSitePublique.PublierProchainsCombats, Mode=OneWay}" 
                                               Value="{Binding GestionnaireSitePublique.NbProchainsCombats}" 
                                               Width="80" MinHeight="26" 
                                               Minimum="1" Maximum="99" 
                                               Increment="1" 
                                               Margin="5 0 5 0"/>
                        </StackPanel>
                        <StackPanel Orientation="Vertical" Margin="30 0 0 -5">
                            <StackPanel Orientation="Horizontal" >
                                <Label HorizontalAlignment="Right" Content="Message d'avertissement :" Style="{StaticResource LabelStyle}" Margin="0 0 0 0"/>
                                <Image Source="pack://application:,,,/FranceJudo.UI;component/Wpf/Resources/Media/Icons/black/info-32.png" Height="20" Margin="0 0 0 0" ToolTip="Message d'avertissement affiché au début des pages 'Prochains combats' et 'Se prépare'."/>
                            </StackPanel>
                            <TextBox  TextWrapping="Wrap" Height="24" VerticalScrollBarVisibility="Auto" Margin="5 5 5 5" MinWidth="300"
                                      Text = "{Binding Path=GestionnaireSitePublique.MsgProchainsCombats}"
                                      IsEnabled="{Binding Path=GestionnaireSitePublique.PublierProchainsCombats}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="4" Grid.Column="2"  Orientation="Vertical" Visibility="{Binding Path=GestionnaireSitePublique.CanPublierEngagements, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel  Orientation="Horizontal">
                        <CheckBox   Content="Publier 'Engagements'" Style="{StaticResource CheckboxStyle}" IsChecked="{Binding Path=GestionnaireSitePublique.PublierEngagements}"/>
                        <Image Source="pack://application:,,,/FranceJudo.UI;component/Wpf/Resources/Media/Icons/black/info-32.png" Height="20" Margin="5 0 0 0" ToolTip="Si cochée, provoque l'ajout du menu 'Engagements' qui liste les engagés, leurs statuts et leurs combats à venir. Disponible uniquement en compétition Individuelle ou Shiai.&#x0a;ATTENTION, cette option augmente sensiblement le temps de génération et le nombre de fichiers à transférer."/>
                    </StackPanel>

                    <StackPanel Orientation="Vertical" Margin="25 0 0 0">
                        <StackPanel Orientation="Vertical">
                            <StackPanel Orientation="Horizontal" Margin="0 0 0 -5">
                                <CheckBox Style="{StaticResource CheckboxStyle}"
                                                IsChecked="{Binding Path=GestionnaireSitePublique.EngagementsAbsents}"
                                                IsEnabled="{Binding Path=GestionnaireSitePublique.PublierEngagements, Mode=OneWay}"
                                                Content="Inclure les absents"/>
                                <Image Source="pack://application:,,,/FranceJudo.UI;component/Wpf/Resources/Media/Icons/black/info-32.png" Height="20" Margin="0 0 0 0" ToolTip="Si cochée, affichera les judokas absents."/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0 0 0 -5">
                                <CheckBox Style="{StaticResource CheckboxStyle}"
                                                IsChecked="{Binding Path=GestionnaireSitePublique.EngagementsTousCombats}"
                                                IsEnabled="{Binding Path=GestionnaireSitePublique.PublierEngagements, Mode=OneWay}"
                                                Content="Inclure tous les combats"/>
                                <Image Source="pack://application:,,,/FranceJudo.UI;component/Wpf/Resources/Media/Icons/black/info-32.png" Height="20" Margin="0 0 0 0" ToolTip="Si cochée, affichera tous les combats des engagés, y compris ceux terminés."/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0 0 0 -5">
                                <CheckBox Style="{StaticResource CheckboxStyle}"
                                                IsChecked="{Binding Path=GestionnaireSitePublique.ScoreEngagesGagnantPerdant}"
                                                IsEnabled="{Binding Path=GestionnaireSitePublique.PublierEngagements, Mode=OneWay}"
                                              Content="Afficher les scores au format Gagnant/Perdant"/>
                                <Image Source="pack://application:,,,/FranceJudo.UI;component/Wpf/Resources/Media/Icons/black/info-32.png" Height="20" Margin="0 0 0 0" ToolTip="Si cochée, les résultats des combats seront affichés dans l'ordre Gagnant/Perdant, sinon, selon l'ordre 1er Judoka/2nd Judoka"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox Style="{StaticResource CheckboxStyle}"
                                                IsChecked="{Binding Path=GestionnaireSitePublique.AfficherPositionCombat}"
                                                IsEnabled="{Binding Path=GestionnaireSitePublique.PublierEngagements, Mode=OneWay}"
                                              Content="Afficher la position des combats"/>
                                <Image Source="pack://application:,,,/FranceJudo.UI;component/Wpf/Resources/Media/Icons/black/info-32.png" Height="20" Margin="0 0 0 0" ToolTip="Si cochée, affiche la position du combat dans l'ordre de déroulement sur le tapis."/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <Line Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" StrokeThickness="1" Stroke="DimGray" Margin="10,0,10,0" X1="0" X2="1" Stretch="Fill"/>
                <Line Grid.Row="5" Grid.Column="2" VerticalAlignment="Center" StrokeThickness="1" Stroke="DimGray" Margin="10 0 10 0" X1="0" X2="1" Stretch="Fill"/>

                <StackPanel Grid.Row="6" Grid.Column="0"  Orientation="Horizontal" VerticalAlignment="Top">
                    <CheckBox   Content="Publier 'Affectation tapis'" Style="{StaticResource CheckboxStyle}"
                                                            IsChecked="{Binding Path=GestionnaireSitePublique.PublierAffectationTapis}"
                                                            Visibility="{Binding Path=GestionnaireSitePublique.CanPublierAffectation, Converter={StaticResource BoolToVisibilityConverter}}">
                    </CheckBox>
                    <Image Visibility="{Binding Path=GestionnaireSitePublique.CanPublierAffectation, Converter={StaticResource BoolToVisibilityConverter}}"
                                   Source="pack://application:,,,/FranceJudo.UI;component/Wpf/Resources/Media/Icons/black/info-32.png" Height="20" Margin="5 0"
                                   ToolTip="Si cochée, provoque l'ajout du menu 'Affectations' qui liste les tapis assignés pour chaque catégorie. Disponible uniquement en compétition Individuelle ou Shiai."/>
                </StackPanel>

                <StackPanel Grid.Row="6" Grid.Column="2"  Orientation="Horizontal" VerticalAlignment="Top">
                    <CheckBox   Content="Publier 'Statistiques'" Style="{StaticResource CheckboxStyle}"
                                            IsChecked="{Binding Path=GestionnaireSitePublique.PublierStatistiques}"
                                            Visibility="{Binding Path=GestionnaireSitePublique.CanPublierStatistiques, Converter={StaticResource BoolToVisibilityConverter}}">
                    </CheckBox>
                    <Image Visibility="{Binding Path=GestionnaireSitePublique.CanPublierStatistiques, Converter={StaticResource BoolToVisibilityConverter}}"
                   Source="pack://application:,,,/FranceJudo.UI;component/Wpf/Resources/Media/Icons/black/info-32.png" Height="20" Margin="5 0"
                   ToolTip="Si cochée, provoque l'ajout du menu 'Statistiques' qui affiche les statistiques des combats de la compétition. Disponible uniquement en compétition Individuelle ou Shiai."/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- BLOC BOUTONS -->
        <WrapPanel HorizontalAlignment="Center" VerticalAlignment="Top" Orientation="Horizontal" Grid.Row="2" Margin="0,0,0,0" Grid.ColumnSpan="2" Grid.Column="0" >
            <Button x:Name="ButOk" Width="70" Height="30"  Click="ButOk_Click">
                <Grid>
                    <TextBlock x:Name="ButOkLabel"  Text="OK" Style="{StaticResource ButtonLabelStyle}" Foreground="White"/>
                </Grid>
            </Button>
        </WrapPanel>
    </Grid>
</hc:Window>
