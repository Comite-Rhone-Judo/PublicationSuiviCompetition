<telerik:RadWindow x:Class="AppPublication.Views.Configuration.TestFtpWindow"
        xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:Tools.Net.Ftp;assembly=Tools"
        Header="Test de la connexion FTP" Height="420" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        CanClose="True" CanMove="True"
        WindowState="Normal"
        Background="Black" Closed="RadWindow_Closed">
    
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Grid.Column="0" Style="{StaticResource Header1Style}" Margin="10,10,10,10" Visibility="Visible" >
            <TextBlock Text="Progression des tests :" FontWeight="Bold" FontSize="14" Style="{StaticResource Header1TextStyle}"/>
        </StackPanel>
        <Border BorderThickness="1" Grid.Row="1" Grid.Column="0" BorderBrush="White" Margin="10 0 10 10">
            <ItemsControl Margin="5 5 5 5" ItemsSource="{Binding TestSteps}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Ellipse x:Name="StatusDot" Width="24" Height="24" Fill="LightGray" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <Control x:Name="StatusSpinner" Style="{StaticResource TrailSpinnerStyle}" Width="24" Height="24" Foreground="White" Margin="5,0" Visibility="Hidden"/>
                            <Label Margin="0 0 0 0" Grid.Column="1" Content="{Binding Name}" VerticalAlignment="Center" FontSize="13" Style="{StaticResource LabelStyle}"/>

                            <TextBlock x:Name="ErrorText" Grid.Row="1" Grid.Column="1" 
                                   Text="{Binding ErrorMessage}" 
                                   Foreground="Orange" FontStyle="Italic" TextWrapping="Wrap" 
                                   Margin="0,0,0,0" Visibility="Collapsed"/>
                        </Grid>

                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Status}" Value="{x:Static models:TestStatus.Running}">
                                <Setter TargetName="StatusDot" Property="Visibility" Value="Hidden"/>
                                <Setter TargetName="StatusSpinner" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="{x:Static models:TestStatus.Success}">
                                <Setter TargetName="StatusDot" Property="Fill" Value="LimeGreen"/>
                                <Setter TargetName="StatusDot" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="StatusSpinner" Property="Visibility" Value="Hidden"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="{x:Static models:TestStatus.Failed}">
                                <Setter TargetName="StatusDot" Property="Fill" Value="Crimson"/>
                                <Setter TargetName="StatusDot" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="ErrorText" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="StatusSpinner" Property="Visibility" Value="Hidden"/>

                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <telerik:RadButton telerik:StyleManager.Theme="Expression_Dark"  IsDefault="True" Margin="0 0 15 0"
               Command="{Binding Path=CmdStartTest}" Height="35">
                <WrapPanel Orientation="Horizontal">
                    <Image Source="pack://application:,,,/Tools;component/data/images/icons/black/play-32.png" Height="25" Margin="5 0"/>
                    <Label Content="Démarrer" Style="{StaticResource ButtonLabelStyle}" />
                </WrapPanel>
            </telerik:RadButton>

            <telerik:RadButton telerik:StyleManager.Theme="Expression_Dark"  IsDefault="True" Margin="0 0 15 0"
               Command="{Binding Path=CmdCancelTest}" Height="35">
                <WrapPanel Orientation="Horizontal">
                    <Image Source="pack://application:,,,/Tools;component/data/images/icons/black/stop-32.png" Height="25" Margin="5 0"/>
                    <Label Content="Annuler" Style="{StaticResource ButtonLabelStyle}" />
                </WrapPanel>
            </telerik:RadButton>

        </StackPanel>
    </Grid>
</telerik:RadWindow>