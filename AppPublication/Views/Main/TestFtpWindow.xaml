<Window x:Class="AppPublication.Views.Configuration.TestFtpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:AppPublication.Models.Publication.FtpTests"
        Title="Test de la connexion FTP" Height="400" Width="450"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Closing="Window_Closing">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Progression des tests :" FontWeight="Bold" FontSize="14" Margin="0,0,0,15"/>

        <ItemsControl Grid.Row="1" ItemsSource="{Binding TestSteps}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Ellipse x:Name="StatusDot" Width="16" Height="16" Fill="LightGray" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" FontSize="13"/>

                        <TextBlock x:Name="ErrorText" Grid.Row="1" Grid.Column="1" 
                                   Text="{Binding ErrorMessage}" 
                                   Foreground="Orange" FontStyle="Italic" TextWrapping="Wrap" 
                                   Margin="0,2,0,5" Visibility="Collapsed"/>
                    </Grid>

                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Status}" Value="{x:Static models:TestStatus.Running}">
                            <Setter TargetName="StatusDot" Property="Fill" Value="DodgerBlue"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="{x:Static models:TestStatus.Success}">
                            <Setter TargetName="StatusDot" Property="Fill" Value="LimeGreen"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="{x:Static models:TestStatus.Failed}">
                            <Setter TargetName="StatusDot" Property="Fill" Value="Crimson"/>
                            <Setter TargetName="ErrorText" Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Lancer le test" Command="{Binding CmdStartTest}" 
                    Width="100" Height="30" Margin="0,0,10,0"/>
            <Button Content="Fermer" Click="BtnClose_Click" Width="100" Height="30"/>
        </StackPanel>
    </Grid>
</Window>