<hc:Window x:Class="AppPublication.Views.Server.RechercheServeurView"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           Title="Recherche d'un serveur" WindowStartupLocation="CenterScreen" 
           ResizeMode="CanResize" 
           Background="Black"
           Width="850" Height="450" Closed="UI_Closed">

    <hc:Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </hc:Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Titre & Toggle Avancé (Ligne 0) -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <!-- Bloc central pour le titre -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image Source="pack://application:,,,/FranceJudo.UI;component/Wpf/Resources/Media/Icons/black/list-32.png" Stretch="Fill" Height="24" Width="24" Margin="4,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="Liste des serveurs TAS disponibles" Style="{StaticResource Header2TextStyle}" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- CheckBox poussée tout à droite sur la même ligne que le titre -->
            <CheckBox Content="Mode Avancé" IsChecked="{Binding IsAdvancedMode}" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="Affiche le ciblage par carte réseau et les options avancées."/>
        </Grid>

        <!-- Configuration du Scan (Ligne 1) -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Mode Standard -->
                <RowDefinition Height="Auto"/>
                <!-- Mode Avancé -->
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <!-- Col 0: Labels alignés à droite -->
                <ColumnDefinition Width="Auto" />
                <!-- Col 1: Contrôles de saisie (Largeur fixe) -->
                <ColumnDefinition Width="Auto" />
                <!-- Col 2: Espace flexible pour repousser les actions à droite -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ================= LIGNE STANDARD (Toujours visible) ================= -->
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Adresse/Nom du serveur :" FontSize="12" Style="{StaticResource Header2TextStyle}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,10"/>

            <TextBox Grid.Row="0" Grid.Column="1" 
                     Text="{Binding RechercheManuelle, UpdateSourceTrigger=PropertyChanged}" 
                     IsEnabled="{Binding IsScanning, Converter={StaticResource BoolNotConverter}}"
                     Width="240" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,10,10"
                     ToolTip="Laissez vide pour scanner le réseau entier. Renseignez une IP pour cibler une machine spécifique."/>

            <Button Grid.Row="0" Grid.Column="2" Command="{Binding CmdLancerRecherche}" Height="30" IsDefault="True"
                    VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,30,10">
                <WrapPanel Orientation="Horizontal">
                    <Image Source="pack://application:,,,/FranceJudo.UI;component/Wpf/Resources/Media/Icons/black/search-32.png" Height="16" Margin="0,0,5,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Lancer la recherche" Style="{StaticResource ButtonLabelStyle}" VerticalAlignment="Center"/>
                </WrapPanel>
            </Button>

            <!-- ================= LIGNE AVANCÉE (Visible si IsAdvancedMode = true) ================= -->
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Réseau à analyser :" FontSize="12" Style="{StaticResource Header2TextStyle}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"
                       Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolToVis}}"/>

            <ComboBox Grid.Row="1" Grid.Column="1" 
                      ItemsSource="{Binding InterfacesReseau}" 
                      SelectedItem="{Binding SelectedInterface}" 
                      IsEnabled="{Binding IsScanning, Converter={StaticResource BoolNotConverter}}"
                      DisplayMemberPath="DisplayName"
                      Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolToVis}}"
                      Width="240" HorizontalAlignment="Left" VerticalAlignment="Center" Height="28" Margin="0,0,10,0"/>

            <CheckBox Grid.Row="1" Grid.Column="2" Content="Recherche systématique" 
                      IsChecked="{Binding BypassPing}"
                      IsEnabled="{Binding IsScanning, Converter={StaticResource BoolNotConverter}}"
                      Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolToVis}}"
                      Foreground="White" 
                      VerticalAlignment="Center" HorizontalAlignment="Left"    Margin="50,0,5,0"
                      ToolTip="Cochez cette option pour désactiver le test de présence réseau (Ping) préalable. La recherche peut-être plus lente."/>
        </Grid>

        <!-- Indicateur de progression (Ligne 2) -->
        <StackPanel Grid.Row="2" Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}" Margin="0,0,0,15" HorizontalAlignment="Center">
            <ProgressBar Minimum="0" Maximum="100" Value="{Binding ScanProgress}" Width="400" Height="10" Foreground="#007ACC" />
        </StackPanel>

        <!-- Liste des résultats (Double clic géré) -->
        <!-- Liste des résultats -->
        <ListBox Grid.Row="3" ItemsSource="{Binding ServeursTrouves}" SelectedItem="{Binding SelectedServeur}" Background="#222" Foreground="White" BorderBrush="#555" Margin="0,5,0,0">

            <!-- SOLUTION GARANTIE : On écoute le double-clic directement sur le conteneur de la ligne -->
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                    <EventSetter Event="MouseDoubleClick" Handler="Serveur_MouseDoubleClick" />
                </Style>
            </ListBox.ItemContainerStyle>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="5" Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Image Grid.Column="0" Source="pack://application:,,,/Tools;component/data/images/icons/server.png" Width="20" Height="20" VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding EndPoint}" FontWeight="Bold" FontSize="14" />
                            <TextBlock Text="{Binding Machine}" Foreground="LightGray" FontSize="11" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="10,0,0,0">
                            <TextBlock Text="{Binding Competition.Element[titre].Value}" FontStyle="Italic" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</hc:Window>