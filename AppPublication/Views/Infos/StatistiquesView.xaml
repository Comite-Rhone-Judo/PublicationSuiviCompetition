<hc:Window x:Class="AppPublication.Views.Infos.StatistiquesView"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:AppPublication.Views.Infos"
        Title="Statistiques" Height="650" Width="900"
        WindowStartupLocation="CenterScreen" 
        ResizeMode="CanResize" 
        WindowState="Normal" Name="UI" Background="{DynamicResource RegionBrush}" Foreground="{DynamicResource PrimaryTextBrush}" SizeToContent="WidthAndHeight">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <!-- PANEL GENERATION -->
        <StackPanel Grid.Row="0" Grid.Column="0" Style="{StaticResource Header1Style}" Margin="10,10,10,10" Visibility="Visible" >
            <TextBlock Text="Génération du site" Style="{StaticResource Header1TextStyle}"/>
        </StackPanel>
        <Border BorderThickness="1" Grid.Row="1" Grid.Column="0" BorderBrush="White" Margin="10 0 10 10">
            <StackPanel Orientation="Vertical">
                <Label HorizontalAlignment="Left" Content="Création des fichiers" Style="{StaticResource HeaderStyle}"/>
                <hc:TabControl Margin="10 10 10 10" Width="410"
                                   BorderThickness="0" BorderBrush="White" Background="{DynamicResource RegionBrush}"
                                   FontWeight="DemiBold">
                    <hc:TabControl.Items>
                        <hc:TabItem Header="Site Coachs &amp; Public" HeaderTemplate="{StaticResource StatHeaderTemplate}" >
                            <Border Background="{DynamicResource RegionBrush}" BorderThickness="1" >
                                <DataGrid ItemsSource="{Binding GenerationSite.CompteursGeneration}" AutoGenerateColumns="False" Style="{StaticResource GridViewStyle1}"
                                            CanUserDeleteRows="False" CanUserAddRows="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Binding="{Binding Value.Libelle}" Header="Compteur" Width="180"/>
                                        <DataGridTextColumn Binding="{Binding Value.Valeur, StringFormat=F0}" Header="Nb" Width="50"/>
                                        <DataGridTextColumn Binding="{Binding Value.Min, StringFormat=F2}" Header="Min." Width="50"/>
                                        <DataGridTextColumn Binding="{Binding Value.Moy, StringFormat=F2}" Header="Moy." Width="50"/>
                                        <DataGridTextColumn Binding="{Binding Value.Max, StringFormat=F2}" Header="Max." Width="50"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                        </hc:TabItem>
                        <hc:TabItem Header="Chambre d'appel" HeaderTemplate="{StaticResource StatHeaderTemplate}">
                            <Border Background="{DynamicResource RegionBrush}" BorderThickness="1" >
                                <DataGrid ItemsSource="{Binding GenerationSiteInterne.CompteursGeneration}" AutoGenerateColumns="False" Style="{StaticResource GridViewStyle1}"
                                            CanUserDeleteRows="False" CanUserAddRows="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Binding="{Binding Value.Libelle}" Header="Compteur" Width="180"/>
                                        <DataGridTextColumn Binding="{Binding Value.Valeur, StringFormat=F0}" Header="Nb" Width="50"/>
                                        <DataGridTextColumn Binding="{Binding Value.Min, StringFormat=F2}" Header="Min." Width="50"/>
                                        <DataGridTextColumn Binding="{Binding Value.Moy, StringFormat=F2}" Header="Moy." Width="50"/>
                                        <DataGridTextColumn Binding="{Binding Value.Max, StringFormat=F2}" Header="Max." Width="50"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                        </hc:TabItem>
                    </hc:TabControl.Items>
                </hc:TabControl>

                <Line StrokeThickness="1" Stroke="White" Margin="10" X1="0" X2="1" Y1="0" Y2="0" Stretch="Fill"/>
                <Label HorizontalAlignment="Left" Content="Réception des données" Style="{StaticResource HeaderStyle}" />
                <DataGrid ItemsSource="{Binding Donnees.CompteursDonnees}" AutoGenerateColumns="False" Style="{StaticResource GridViewStyle1}"
                    CanUserDeleteRows="False" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding Value.Libelle}" Header="Compteur" Width="180"/>
                        <DataGridTextColumn Binding="{Binding Value.Valeur, StringFormat=F0}" Header="Nb" Width="50"/>
                        <DataGridTextColumn Binding="{Binding Value.Min, StringFormat=F2}" Header="Min." Width="50"/>
                        <DataGridTextColumn Binding="{Binding Value.Moy, StringFormat=F2}" Header="Moy." Width="50"/>
                        <DataGridTextColumn Binding="{Binding Value.Max, StringFormat=F2}" Header="Max." Width="50"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>

        <!-- PANEL SYNCHRONISATION -->
        <StackPanel Grid.Row="0" Grid.Column="1" Style="{StaticResource Header1Style}" Margin="10,10,10,10" Visibility="Visible" >
            <TextBlock Text="Synchronisation du site distant" Style="{StaticResource Header1TextStyle}"/>
        </StackPanel>
        <Border BorderThickness="1" Grid.Row="1" Grid.Column="1" BorderBrush="White" Margin="10 0 10 10" >
            <StackPanel Orientation="Vertical">
                <!-- SECTION SYNCHRONISATION COMPLETE -->
                <Label HorizontalAlignment="Left" Content="Synchronisation Complète" Style="{StaticResource HeaderStyle}" />
                <DataGrid ItemsSource="{Binding Synchronisation.CompteursSynchronisationComplete}" AutoGenerateColumns="False" Style="{StaticResource GridViewStyle1}"
                    CanUserDeleteRows="False" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding Value.Libelle}" Header="Compteur" Width="180"/>
                        <DataGridTextColumn Binding="{Binding Value.Valeur, StringFormat=F0}" Header="Nb" Width="50"/>
                        <DataGridTextColumn Binding="{Binding Value.Min, StringFormat=F2}" Header="Min." Width="50"/>
                        <DataGridTextColumn Binding="{Binding Value.Moy, StringFormat=F2}" Header="Moy." Width="50"/>
                        <DataGridTextColumn Binding="{Binding Value.Max, StringFormat=F2}" Header="Max." Width="50"/>
                    </DataGrid.Columns>
                </DataGrid>
                <!-- SECTION SYNCHRONISATION DIFFERENCE -->
                <Line StrokeThickness="1" Stroke="White" Margin="10" X1="0" X2="1" Y1="0" Y2="0" Stretch="Fill"/>
                <Label HorizontalAlignment="Left" Content="Synchronisation des différences" Style="{StaticResource HeaderStyle}" />
                <DataGrid ItemsSource="{Binding Synchronisation.CompteursSynchronisationDifference}" AutoGenerateColumns="False" Style="{StaticResource GridViewStyle1}"
                    CanUserDeleteRows="False" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding Value.Libelle}" Header="Compteur" Width="180"/>
                        <DataGridTextColumn Binding="{Binding Value.Valeur, StringFormat=F0}" Header="Nb" Width="50"/>
                        <DataGridTextColumn Binding="{Binding Value.Min, StringFormat=F2}" Header="Min." Width="50"/>
                        <DataGridTextColumn Binding="{Binding Value.Moy, StringFormat=F2}" Header="Moy." Width="50"/>
                        <DataGridTextColumn Binding="{Binding Value.Max, StringFormat=F2}" Header="Max." Width="50"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>
    </Grid>
</hc:Window>
