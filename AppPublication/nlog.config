<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwConfigExceptions="true">

	<variable name="loggingLevel" value="Info"/>

	<targets>
		<target name="logFile" xsi:type="File" fileName="./Log/AppPublication.log" maxArchiveFiles="50" archiveAboveSize="10485760" archiveNumbering="Rolling" layout="${when:when=level&lt;=LogLevel.Info:inner=${longdate}|${level}|${callsite:className=True:fileName=False:includeSourcePath=False:methodName=True:captureStackTrace=False}|${message} |${all-event-properties} ${exception:format=toString}:else=${longdate}|${level}|${callsite:className=True:fileName=False:includeSourcePath=False:methodName=True:captureStackTrace=False}|${message} |${all-event-properties} ${exception:format=toString}${stacktrace:format=DetailedFlat:topFrames=20:separator=}}"/>
		<target name="logDataFile" xsi:type="File" fileName="./Log/AppPublication_DebugData.log" maxArchiveFiles="50" archiveAboveSize="104857600" archiveNumbering="Rolling"/>
		<target name="logHealthFile" xsi:type="File" fileName="./Log/AppPublication_HealthData.log" maxArchiveFiles="50" archiveAboveSize="104857600" archiveNumbering="Rolling"/>
	</targets>

	<rules>
		<logger name="defaultLogger" minlevel="${var:loggingLevel}" writeTo="logfile"/>
		<logger name="dbgDataLogger" minlevel="${var:loggingLevel}" writeTo="logDataFile"/>
		<logger name="healthLogger" minlevel="${var:loggingLevel}" writeTo="logHealthFile"/>
	</rules>

</nlog>