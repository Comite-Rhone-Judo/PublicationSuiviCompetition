<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:FranceJudo.UI.Wpf.Controls">

	<Style TargetType="{x:Type controls:TrailSpinner}">
		<Setter Property="Foreground" Value="White" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Control">
					<Grid x:Name="Root"
                      Background="Transparent"
                      RenderTransformOrigin="0.5, 0.5">

						<Grid.RenderTransform>
							<RotateTransform x:Name="SpinnerRotate" Angle="0" />
						</Grid.RenderTransform>

						<Viewbox>
							<Canvas Width="100" Height="100">
								<Ellipse Width="20" Height="20" Fill="{TemplateBinding Foreground}" Opacity="1.0" Canvas.Left="40" Canvas.Top="0"/>

								<Ellipse Width="20" Height="20" Fill="{TemplateBinding Foreground}" Opacity="0.85" Canvas.Left="40" Canvas.Top="0">
									<Ellipse.RenderTransform>
										<RotateTransform Angle="45" CenterX="10" CenterY="50" />
									</Ellipse.RenderTransform>
								</Ellipse>

								<Ellipse Width="20" Height="20" Fill="{TemplateBinding Foreground}" Opacity="0.70" Canvas.Left="40" Canvas.Top="0">
									<Ellipse.RenderTransform>
										<RotateTransform Angle="90" CenterX="10" CenterY="50" />
									</Ellipse.RenderTransform>
								</Ellipse>

								<Ellipse Width="20" Height="20" Fill="{TemplateBinding Foreground}" Opacity="0.55" Canvas.Left="40" Canvas.Top="0">
									<Ellipse.RenderTransform>
										<RotateTransform Angle="135" CenterX="10" CenterY="50" />
									</Ellipse.RenderTransform>
								</Ellipse>

								<Ellipse Width="20" Height="20" Fill="{TemplateBinding Foreground}" Opacity="0.40" Canvas.Left="40" Canvas.Top="0">
									<Ellipse.RenderTransform>
										<RotateTransform Angle="180" CenterX="10" CenterY="50" />
									</Ellipse.RenderTransform>
								</Ellipse>

								<Ellipse Width="20" Height="20" Fill="{TemplateBinding Foreground}" Opacity="0.25" Canvas.Left="40" Canvas.Top="0">
									<Ellipse.RenderTransform>
										<RotateTransform Angle="225" CenterX="10" CenterY="50" />
									</Ellipse.RenderTransform>
								</Ellipse>

								<Ellipse Width="20" Height="20" Fill="{TemplateBinding Foreground}" Opacity="0.15" Canvas.Left="40" Canvas.Top="0">
									<Ellipse.RenderTransform>
										<RotateTransform Angle="270" CenterX="10" CenterY="50" />
									</Ellipse.RenderTransform>
								</Ellipse>

								<Ellipse Width="20" Height="20" Fill="{TemplateBinding Foreground}" Opacity="0.05" Canvas.Left="40" Canvas.Top="0">
									<Ellipse.RenderTransform>
										<RotateTransform Angle="315" CenterX="10" CenterY="50" />
									</Ellipse.RenderTransform>
								</Ellipse>
							</Canvas>
						</Viewbox>
					</Grid>

					<ControlTemplate.Triggers>
						<Trigger Property="IsVisible" Value="True">
							<Trigger.EnterActions>
								<BeginStoryboard x:Name="TrailSpinStoryboard">
									<Storyboard>
										<DoubleAnimation Storyboard.TargetName="SpinnerRotate"
                                                         Storyboard.TargetProperty="Angle"
                                                         From="360" To="0"
                                                         Duration="0:0:1.0"
                                                         RepeatBehavior="Forever" />
									</Storyboard>
								</BeginStoryboard>
							</Trigger.EnterActions>
							<Trigger.ExitActions>
								<RemoveStoryboard BeginStoryboardName="TrailSpinStoryboard"/>
							</Trigger.ExitActions>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	
    <Style TargetType="{x:Type controls:BusyIndicator}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:BusyIndicator}">
                    <Grid>
                        <ContentPresenter Content="{TemplateBinding Content}" />

                        <Grid x:Name="BusyOverlay" Visibility="Collapsed" Panel.ZIndex="999">
                            <Border Background="#B2000000" />

                            <Border Background="{DynamicResource RegionBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="30"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                MinWidth="300" MaxWidth="500">
                                <StackPanel>
                                    <ContentPresenter Content="{TemplateBinding BusyContent}" 
                                                  Margin="0,0,0,20">
                                        <ContentPresenter.Resources>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                                <Setter Property="FontSize" Value="12"/>
                                                <Setter Property="FontWeight" Value="Regular"/>
                                                <Setter Property="TextWrapping" Value="Wrap"/>
                                                <Setter Property="TextAlignment" Value="Center"/>
                                            </Style>
                                        </ContentPresenter.Resources>
                                    </ContentPresenter>

                                    <ProgressBar Height="10" 
                                             IsIndeterminate="{TemplateBinding IsIndeterminate}"
                                             Value="{TemplateBinding ProgressValue}"
                                             Foreground="{DynamicResource PrimaryBrush}"
                                             Background="{DynamicResource SecondaryRegionBrush}"
                                             BorderThickness="0" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsBusy" Value="True">
                            <Setter TargetName="BusyOverlay" Property="Visibility" Value="Visible" />
                            <Setter Property="IsHitTestVisible" Value="False" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>