<hc:Window
    x:Class="FranceJudo.UI.Wpf.Dialogs.ConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:hc="https://handyorg.github.io/handycontrol"   WindowStartupLocation="CenterScreen"     
        Title="Confirmation" mc:Ignorable="d" Width="320" Height="160" ResizeMode="NoResize"  Background="{DynamicResource RegionBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Image Source="pack://application:,,,/FranceJudo.UI;component/Wpf/Resources/Media/Icons/white/help-32.png"
            Height="50" Width="50" Margin="10 10 10 10"
            Grid.Column="0" Grid.Row="0"/>
                
        <TextBlock Name="LabelMessage"
                   Grid.Column="1" Grid.Row="0"
                   Text="Le texte sera passé en paramètre"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   VerticalAlignment="Center" Foreground="WhiteSmoke" Margin="10 10 10 10"/>

        <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Orientation="Horizontal"
                   Grid.Column="0" Grid.Row="1" Margin="10 10 10 10" Grid.ColumnSpan="2" >
            <Button x:Name="ButOk" Click="ButOk_Click" Width="70" Height="25" >
                <Grid>
                    <!--<Image Source="pack://application:,,,/FranceJudo.UI.Wpf;component/Resources/Media/Icons/black/ok-32.png" Height="25" Margin="5 0"/>-->
                    <TextBlock x:Name="ButOkLabel"  Text="Ok" Foreground="White"/>
                </Grid>
            </Button>
            <Button x:Name="ButAnnuler" Click="ButAnnuler_Click" Margin="10 0 0 0"  Width="70" Height="25" >
                <Grid>
                    <!--<Image Source="pack://application:,,,/FranceJudo.UI.Wpf;component/Resources/Media/Icons/black/cancel-32.png" Height="25" Margin="5 0" />-->
                    <TextBlock x:Name="ButAnnulerLabel"  Text="Annuler" Foreground="White" />
                </Grid>
            </Button>
        </WrapPanel>

    </Grid>
</hc:Window>
