<hc:Window
    x:Class="FranceJudo.UI.Wpf.Dialogs.AlertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:hc="https://handyorg.github.io/handycontrol" WindowStartupLocation="CenterScreen"     
        Title="Attention" mc:Ignorable="d" MinWidth="350" ResizeMode="NoResize" MaxWidth="600" Height="180" Background="{DynamicResource RegionBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>


        <Image Source="pack://application:,,,/FranceJudo.UI;component/Wpf/Resources/Media/Icons/white/warning_shield-32.png"
               Margin="15" Height="50" Width="50"
               Grid.Column="0" Grid.Row="0"/>
       
        <TextBlock Name="LabelMessage" Grid.Column="1" Grid.Row="0" Text=""  TextWrapping="Wrap" VerticalAlignment="Center" Foreground="WhiteSmoke" Margin="10"/>

        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Orientation="Horizontal" Grid.Row="1" Grid.ColumnSpan="2" Margin="10" >
            <Button x:Name="ButOk" Click="ButOk_Click" Width="70" Height="25" VerticalAlignment="Bottom">
                <Grid>
                    <TextBlock x:Name="ButOkLabel"  Text="Ok" Foreground="White"/>
                </Grid>
            </Button>         
        </StackPanel>
    </Grid>
</hc:Window>
